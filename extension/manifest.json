{
  "manifest_version": 3,
  "name": "Herocon Doppel Collector",
  "version": "2.1.0",
  "description": "Collect product details from Doppel pages you browse and export JSON without imports.",
  "permissions": [
    "storage",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://doppel.fit/*",
    "https://*.doppel.fit/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://doppel.fit/*",
        "https://*.doppel.fit/*"
      ],
      "js": [
        "doppel-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}